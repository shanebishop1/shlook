{
  "name": "shlook",
  "version": "0.2.5",
  "description": "Private-by-default artifact hosting for agents",
  "license": "MIT",
  "author": "Shane Bishop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanebishop1/shlook.git"
  },
  "bin": {
    "shlook": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "migrations",
    "skills",
    "src/artifact.ts",
    "src/asset-metadata.ts",
    "src/asset-store.ts",
    "src/cleanup.ts",
    "src/index.ts",
    "src/owner-ui.ts",
    "src/privacy.ts",
    "src/request.ts",
    "src/secret-crypto.ts",
    "src/upload-limits.ts",
    "src/worker",
    "src/ui",
    "wrangler.jsonc",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "pnpm build:worker && pnpm build:cli",
    "build:cli": "tsc --project tsconfig.cli.build.json",
    "build:worker": "wrangler deploy --dry-run --outdir /tmp/shlook-worker",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test",
    "ci": "pnpm check && pnpm test:browser && pnpm build",
    "deploy": "wrangler deploy --config .wrangler.deploy.jsonc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src",
    "prepack": "pnpm build:cli",
    "test": "vitest run && node --test src/cli-files.node-check.ts test/client-archive.node-test.ts",
    "test:browser": "playwright test",
    "typecheck": "pnpm typecheck:worker && pnpm typecheck:cli && pnpm typecheck:browser",
    "typecheck:browser": "tsc --project tsconfig.browser.json",
    "typecheck:cli": "tsc --project tsconfig.cli.json",
    "typecheck:worker": "tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "wrangler": "4.126.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/workers-types": "5.20260825.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "jsdom": "29.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
