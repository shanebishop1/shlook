{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "@playwright/test", "@cloudflare/workers-types"],
    "allowImportingTsExtensions": true
  },
  "include": ["playwright.config.ts", "test/browser/**/*.ts"],
  "exclude": ["test/browser/native-ui.spec.ts", "test/browser/native-markdown-download.spec.ts"]
}
